<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071019"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A340 TECHNICAL ASSISTANT"
                    android:textColor="#F7FAFD"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="LINE MAINTENANCE • OFFLINE KNOWLEDGE SYSTEM"
                    android:textColor="#7890A8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="50dp"
                android:layout_height="46dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:text="⚙"
                android:textSize="22sp"
                app:cornerRadius="12dp"
                app:strokeColor="#36536E" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#0E1A25"
            android:padding="11dp"
            android:text="Checking technical library…"
            android:textColor="#AFC5D8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="#0D1721"
            app:cardCornerRadius="14dp"
            app:strokeColor="#34506B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SETTINGS & DIAGNOSTICS"
                    android:textColor="#DCE8F2"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#071019"
                    android:padding="10dp"
                    android:textColor="#A9BDCF"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportDb"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="IMPORT / UPDATE DATABASE"
                    android:textSize="10sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#47627C" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPdfFolder"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="5dp"
                    android:text="SELECT PDF ROOT FOLDER"
                    android:textSize="10sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#47627C" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="5dp"
                    android:text="IMPORT LOCAL AI MODEL (.LITERTLM)"
                    android:textSize="10sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#47627C" />

                <TextView
                    android:id="@+id/txtManuals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#071019"
                    android:padding="10dp"
                    android:textColor="#91A9BD"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="DIAGNOSTIC LOG"
                    android:textColor="#7890A8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtLog"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="5dp"
                    android:background="#050B10"
                    android:padding="9dp"
                    android:scrollbars="vertical"
                    android:textColor="#AFC0D1"
                    android:textIsSelectable="true"
                    android:textSize="9sp"
                    android:typeface="monospace" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefreshLog"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="REFRESH"
                        android:textSize="9sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyLog"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="COPY"
                        android:textSize="9sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearLog"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="CLEAR"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="AIRCRAFT / DEFECT"
            android:textColor="#7890A8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="#0E1822"
            app:cardCornerRadius="14dp"
            app:strokeColor="#25384A"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="13dp">

                <EditText
                    android:id="@+id/editAircraft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="REG / MSN / effectivity"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6F8497"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editQuery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="top|start"
                    android:hint="Fault / ECAM / PFR / TSM request / FIN / P/N"
                    android:minHeight="78dp"
                    android:minLines="2"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6F8497"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearch"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="RUN LINE MAINTENANCE WORKFLOW"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#1E6FC2"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPfr"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="PFR"
                android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTechLog"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="TECH LOG"
                android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnComponent"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="COMPONENT"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ocrContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtSummaryHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="ENGINEERING SUMMARY"
            android:textColor="#78B7E8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtEngineeringSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#0D1A24"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:textColor="#E3ECF3"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtSourcesHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="SOURCE DOCUMENT PACKET"
            android:textColor="#78B7E8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/sourceContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtAiHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="OPTIONAL LOCAL AI EXPLANATION"
            android:textColor="#7890A8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/aiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            app:cardBackgroundColor="#0E1822"
            app:cardCornerRadius="12dp"
            app:strokeColor="#25485C"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAi"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="GENERATE OPTIONAL LOCAL AI EXPLANATION"
                    android:textSize="11sp"
                    app:backgroundTint="#1C8B78"
                    app:cornerRadius="9dp" />

                <ProgressBar
                    android:id="@+id/aiProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="0"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtAiState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#8FB5C5"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtAiAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#E6EEF5"
                    android:textIsSelectable="true"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
