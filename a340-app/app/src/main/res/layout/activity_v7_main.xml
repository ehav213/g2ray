<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F14"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A340 TECHNICAL ASSISTANT"
            android:textColor="#F4F7FB"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="OFFLINE MAINTENANCE KNOWLEDGE SYSTEM"
            android:textColor="#7F8FA6"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#111821"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#263445"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="11dp"
                android:paddingEnd="14dp"
                android:paddingBottom="11dp"
                android:text="Checking technical library…"
                android:textColor="#B9C8D8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textIsSelectable="true" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="AIRCRAFT &amp; TECHNICAL QUERY"
            android:textColor="#8EA2BA"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#111821"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#263445"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <EditText
                    android:id="@+id/editAircraft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#50647A"
                    android:hint="Aircraft profile — REG / MSN / effectivity"
                    android:singleLine="true"
                    android:textColor="#F4F7FB"
                    android:textColorHint="#70839A"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editQuery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#50647A"
                    android:gravity="top|start"
                    android:hint="Fault / ECAM / ATA / FIN / P/N / technical question"
                    android:minHeight="92dp"
                    android:minLines="3"
                    android:paddingTop="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#70839A"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetrieve"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="SEARCH APPROVED MANUAL EVIDENCE"
                    android:textAllCaps="true"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#2463B5"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PHOTO INPUT"
            android:textColor="#8EA2BA"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPfr"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="PFR"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="9dp"
                app:strokeColor="#3D5876" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCaptain"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:text="TECH LOG"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="9dp"
                app:strokeColor="#3D5876" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnComponent"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="COMPONENT"
                android:textSize="10sp"
                android:textStyle="bold"
                app:cornerRadius="9dp"
                app:strokeColor="#3D5876" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="OCR DEFECTS"
            android:textColor="#D4DFEB"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ListView
            android:id="@+id/listCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#111821"
            android:divider="#263445"
            android:dividerHeight="1dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtEvidenceHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="APPROVED EVIDENCE"
            android:textColor="#8EA2BA"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtAnalysis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#111821"
            android:padding="14dp"
            android:textColor="#AFC0D2"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/listResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#111821"
            android:divider="#263445"
            android:dividerHeight="1dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="CONFIRM OPENED RESULT FOR SAFE LEARNING"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="9dp"
            app:strokeColor="#3D5876" />

        <TextView
            android:id="@+id/txtAiHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="LOCAL AI ANALYSIS"
            android:textColor="#8EA2BA"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnswer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="GENERATE GROUNDED AI ANSWER"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#1C806F"
            app:cornerRadius="10dp" />

        <TextView
            android:id="@+id/txtAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#111821"
            android:minHeight="100dp"
            android:padding="14dp"
            android:textColor="#E7EEF6"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="TECHNICAL LIBRARY"
            android:textColor="#8EA2BA"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#111821"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#263445"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/txtManuals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="No technical library loaded"
                android:textColor="#9FB1C4"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="SETUP &amp; DATA"
            android:textColor="#8EA2BA"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/txtModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#111821"
            android:padding="12dp"
            android:text="No local LLM model installed"
            android:textColor="#9FB1C4"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportDb"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="IMPORT / UPDATE DATABASE"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:strokeColor="#344A63" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPdfFolder"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:text="SELECT PDF ROOT FOLDER"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:strokeColor="#344A63" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:text="IMPORT LOCAL AI MODEL (.LITERTLM)"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:strokeColor="#344A63" />

        <Button
            android:id="@+id/btnLegacy"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
