<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Database not loaded"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnImportDb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IMPORT / UPDATE DATABASE" />
        <Button
            android:id="@+id/btnPdfFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SELECT PDF ROOT FOLDER" />
        <Button
            android:id="@+id/btnCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PHOTO POST FLIGHT → AI FAULTS" />
        <Button
            android:id="@+id/btnCaptainReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PHOTO CAPTAIN / TECH LOG → AI DEFECT" />
        <Button
            android:id="@+id/btnComponentPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PHOTO COMPONENT → AI ID SEARCH" />
        <TextView
            android:id="@+id/txtReportSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="PFR or Captain/Tech Log defect cards will appear here after OCR."
            android:textStyle="bold" />
        <ListView
            android:id="@+id/listFaults"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:dividerHeight="1dp" />
        <EditText
            android:id="@+id/editAircraftProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Aircraft profile (optional): REG / MSN / customer / effectivity"
            android:singleLine="true" />
        <EditText
            android:id="@+id/editQuery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Natural language, Persian/English fault, ATA, FIN, P/N, task…"
            android:minLines="2" />
        <Button
            android:id="@+id/btnAiSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI RETRIEVAL — OFFLINE" />
        <Button
            android:id="@+id/btnSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CLASSIC DATABASE SEARCH" />
        <TextView
            android:id="@+id/txtAiSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="AI retrieval: evidence-only. Source manuals remain authoritative."
            android:textIsSelectable="true" />
        <TextView
            android:id="@+id/txtManuals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp" />
        <ListView
            android:id="@+id/listResults"
            android:layout_width="match_parent"
            android:layout_height="650dp"
            android:dividerHeight="1dp" />
    </LinearLayout>
</ScrollView>
