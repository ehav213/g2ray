+    private fun ipcHitsForPossibleCause(cause: PossibleCause, tsm: LineTsmResolution): List<SearchHit> {
+        val out = mutableListOf<SearchHit>()
+        val seen = linkedSetOf<String>()
+        fun add(fin: String, pn: String, nomenclature: String, rawBlock: String, exact: Boolean) {
+            if (pn.isBlank()) return
+            val key = "${normalizeToken(fin)}|${normalizeToken(pn)}"
+            if (!seen.add(key)) return
+            val matchType = if (exact) "EXACT FIN/PN" else "ATA + NOMENCLATURE"
+            val ref = fin.ifBlank { pn }
+            out += SearchHit(
+                "part_number", pn, "IPC", ref,
+                "POSSIBLE CAUSE ${cause.index} • ${cause.text} → ${nomenclature.ifBlank { pn }}",
+                "$matchType MATCH FROM VERIFIED TSM POSSIBLE CAUSE\\n${rawBlock.take(1500)}",
+                if (exact) -4450.0 else -3950.0
+            )
+        }
+
+        cause.identifiers.distinct().take(8).forEach { id ->
+            runCatching {
+                db.rawQuery(
+                    "SELECT COALESCE(fin,''),part_number,COALESCE(nomenclature,''),COALESCE(raw_block,'') " +
+                        "FROM ipc_items WHERE UPPER(COALESCE(fin,''))=? OR UPPER(part_number)=? " +
+                        "ORDER BY pdf_page LIMIT 8",
+                    arrayOf(normalizeToken(id), normalizeToken(id))
+                ).use { c ->
+                    while (c.moveToNext()) add(c.getString(0), c.getString(1), c.getString(2), c.getString(3), true)
+                }
+            }
+        }
+        if (out.isNotEmpty()) return out.take(6)
+
+        val terms = possibleCauseTerms(cause.text)
+        if (terms.isEmpty()) return emptyList()
+        val chapter = tsm.taskRef.take(2).filter(Char::isDigit)
+        if (chapter.length != 2) return emptyList()
+        val queryTerms = terms.take(5)
+        val where = queryTerms.joinToString(" OR ") { "UPPER(COALESCE(nomenclature,'')) LIKE ?" }
+        val args = queryTerms.map { "%$it%" }.toMutableList().apply { add("$chapter-%") }.toTypedArray()
+        val candidates = mutableListOf<Array<String>>()
+        runCatching {
+            db.rawQuery(
+                "SELECT COALESCE(fin,''),part_number,COALESCE(nomenclature,''),COALESCE(raw_block,'') " +
+                    "FROM ipc_items WHERE ($where) AND COALESCE(catalog_ref,'') LIKE ? ORDER BY pdf_page LIMIT 120",
+                args
+            ).use { c ->
+                while (c.moveToNext()) candidates += arrayOf(c.getString(0), c.getString(1), c.getString(2), c.getString(3))
+            }
+        }
+        data class Ranked(val row: Array<String>, val overlap: Int, val coverage: Double)
+        val wanted = terms.toSet()
+        if (wanted.size < 2) return emptyList()
+        val minimumOverlap = when (wanted.size) {
+            2 -> 2
+            3 -> 3
+            else -> maxOf(2, (wanted.size * 2 + 2) / 3)
+        }
+        val ranked = candidates.map { row ->
+            val have = possibleCauseTerms(row[2]).toSet()
+            val overlap = wanted.intersect(have).size
+            val coverage = overlap.toDouble() / wanted.size.toDouble()
+            Ranked(row, overlap, coverage)
+        }.filter { it.overlap >= minimumOverlap && it.coverage >= 0.66 }
+            .sortedWith(compareByDescending<Ranked> { it.coverage }.thenByDescending { it.overlap })
+
+        ranked.take(4).forEach { r -> add(r.row[0], r.row[1], r.row[2], r.row[3], false) }
+        return out
+    }
+
+    private fun possibleCauseTerms(text: String): List<String> {
+        val stop = setOf(
+            "THE", "AND", "OR", "OF", "TO", "FROM", "WITH", "WITHOUT", "A", "AN", "AIRCRAFT",
+            "SYSTEM", "ASSY", "ASSEMBLY", "LH", "RH", "LEFT", "RIGHT", "UNIT", "FAULT", "FAILED", "FAILURE"
+        )
+        val base = normalizeText(text).replace(Regex("\\([^)]*\\)"), " ")
+        return Regex("[A-Z][A-Z0-9]{2,}").findAll(base).map { it.value }
+            .map { when (it) { "CONTROLLER" -> "CONTROL"; else -> it } }
+            .filter { it !in stop && !it.matches(Regex("\\d+")) }
+            .distinct().toList()
+    }
