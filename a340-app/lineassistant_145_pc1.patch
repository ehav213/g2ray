+            Regex("\\b(?:REF\\.\\s*)?AWM\\s+(\\d{2}-\\d{2}(?:[-/]\\d{2})?)\\b")
+                .findAll(upper).map { it.groupValues[1].replace('/', '-') }.distinct().take(8)
+                .forEach { ref -> awmDiagramHit(ref)?.let { add(it.copy(title = "POSSIBLE CAUSE • AIRCRAFT WIRING • ${it.title}")) } }
+            Regex("\\b(?:REF\\.\\s*)?ESPM\\s+(\\d{2}-\\d{2}(?:[-/]\\d{2})?)\\b")
+                .findAll(upper).map { it.groupValues[1].replace('/', '-') }.distinct().take(6)
+                .forEach { ref -> espmHit(ref)?.let { add(it.copy(title = "POSSIBLE CAUSE • AIRCRAFT WIRING • ${it.title}")) } }
+        }
+        return out.take(48)
+    }
