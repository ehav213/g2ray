+    private fun extractPossibleCauses(tsm: LineTsmResolution): List<PossibleCause> {
+        val text = tsm.taskContent.replace("\r", "")
+        val start = Regex("(?im)^\\s*(?:1\\.\\s*)?Possible Causes\\s*$", RegexOption.IGNORE_CASE).find(text) ?: return emptyList()
+        val tail = text.substring(start.range.last + 1)
+        val end = Regex("(?im)^\\s*(?:2\\.?\\s*)?(?:\\n\\s*)?Job Set-up Information\\s*$", RegexOption.IGNORE_CASE).find(tail)
+        val section = (if (end == null) tail else tail.substring(0, end.range.first)).trim()
+        if (section.isBlank()) return emptyList()
+
+        fun ignorable(line: String): Boolean {
+            val u = normalizeText(line)
+            return u.isBlank() ||
+                u.matches(Regex("^\\d+[.]?$")) ||
+                u.matches(Regex("^PAGE\\s+\\d+\\s+OF\\s+\\d+$")) ||
+                u.matches(Regex("^\\d{2}-\\d{2}\\s+-\\s+.+$")) ||
+                u.startsWith("** ON A/C") || u.startsWith("ON A/C ")
+        }
+
+        val raw = mutableListOf<String>()
+        var current: StringBuilder? = null
+        var waitingForBulletText = false
+        var sawBullet = false
+        fun flush() {
+            val value = current?.toString()?.replace(Regex("\\s+"), " ")?.trim().orEmpty()
+            if (value.isNotBlank() && !ignorable(value)) raw += value
+            current = null
+        }
+
+        section.lines().forEach { sourceLine ->
+            var line = sourceLine.trim()
+            if (ignorable(line)) return@forEach
+            val bullet = Regex("^[·•\\-–—*]+\\s*(.*)$").find(line)
+            if (bullet != null) {
+                sawBullet = true
+                flush()
+                line = bullet.groupValues[1].trim()
+                if (line.isBlank()) {
+                    waitingForBulletText = true
+                } else {
+                    current = StringBuilder(line)
+                    waitingForBulletText = false
+                }
+                return@forEach
+            }
+            if (waitingForBulletText) {
+                current = StringBuilder(line)
+                waitingForBulletText = false
+                return@forEach
+            }
+            if (current != null) {
+                current!!.append(' ').append(line)
+            } else if (!sawBullet) {
+                if (line.length <= 180) raw += line
+            }
+        }
+        flush()
+
+        return raw.map { it.trim(' ', '.', ';') }
+            .filter { it.isNotBlank() }
+            .distinctBy(::normalizeText)
+            .take(32)
+            .mapIndexed { i, causeText ->
+                val upper = normalizeText(causeText)
+                PossibleCause(
+                    index = i + 1,
+                    text = causeText,
+                    identifiers = extractIdentifiers(causeText),
+                    wiringLike = listOf("WIRING", "WIRE", "HARNESS", "CABLE", "CONNECTOR", "CONTACT", "SPLICE", "GROUND")
+                        .any { upper.contains(it) }
+                )
+            }
+    }
