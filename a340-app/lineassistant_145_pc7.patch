+    private fun showBatchResults(results: List<LineAssistantResult>, label: String) {
+        currentResult = null
+        currentHits = results.flatMap { it.hits }
+        txtResultHeading.visibility = View.VISIBLE
+        txtResult.visibility = View.VISIBLE
+        txtResult.text = buildString {
+            append("PFR BATCH RESULT • ").append(results.size).append(" EVENT(S)\n")
+            append("Each event is resolved independently through the authoritative TSM Fault Symptom List.\n")
+            results.forEachIndexed { index, result ->
+                val fault = result.structuredFault
+                append("\n==============================\n")
+                append("EVENT ").append(fault?.number ?: index + 1)
+                if (!fault?.text.isNullOrBlank()) append(" • ").append(fault?.text)
+                append("\n==============================\n")
+                append(result.summary.trim()).append('\n')
+            }
+        }
+        renderBatchSourcePacket(results)
+        aiCard.visibility = View.GONE
+        val resolved = results.count { it.tsm != null }
+        val unresolved = results.size - resolved
+        status("$label • TSM RESOLVED $resolved/${results.size} • UNRESOLVED $unresolved")
+        appLog.i("PFR_BATCH_RESOLVE_OK", "events=${results.size} resolved=$resolved unresolved=$unresolved")
+    }
+
+    private fun renderBatchSourcePacket(results: List<LineAssistantResult>) {
+        sourceContainer.removeAllViews()
+        val anyHits = results.any { it.hits.isNotEmpty() }
+        if (!anyHits) return
+        txtSourcesHeading.visibility = View.VISIBLE
+        sourceContainer.visibility = View.VISIBLE
+        results.forEachIndexed { index, result ->
+            val fault = result.structuredFault
+            sourceContainer.addView(sectionHeader("EVENT ${fault?.number ?: index + 1} • ${fault?.text.orEmpty()}"))
+            var lastStage = ""
+            result.hits.forEach { hit ->
+                val stage = stageLabel(hit)
+                if (stage != lastStage) {
+                    sourceContainer.addView(sectionHeader(stage))
+                    lastStage = stage
+                }
+                sourceContainer.addView(sourceCard(hit))
+            }
+        }
+    }
