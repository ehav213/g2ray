+    private fun findAuthoritativeFaultIndexCandidates(input: FaultInput): List<TsmIndexRecord> {
+        if (input.maintenanceMessage.isBlank()) return emptyList()
+        val records = mutableListOf<TsmIndexRecord>()
+        val seen = linkedSetOf<String>()
+        val terms = buildList {
+            val ata = input.maintenanceAta?.trim().orEmpty()
+            if (ata.matches(Regex("\\d{2}-\\d{2}-\\d{2}"))) add(ata)
+            extractIdentifiers(input.maintenanceMessage).take(3).forEach(::add)
+            significantWords(input.maintenanceMessage).take(5).forEach(::add)
+        }.filter { it.isNotBlank() }.distinct()
+
+        // Search only index-bearing TSM chunks. FTS locates candidate pages; the
+        // final decision is exact record comparison below, never FTS ranking.
+        val expressions = mutableListOf<String>()
+        val ids = extractIdentifiers(input.maintenanceMessage).map(::normalizeToken).filter { it.length >= 3 }.distinct()
+        if (ids.isNotEmpty()) expressions += ids.take(3).joinToString(" AND ") { "\"$it\"" }
+        val words = significantWords(input.maintenanceMessage)
+        if (words.isNotEmpty()) expressions += words.take(5).joinToString(" AND ") { "\"$it\"*" }
+        if (terms.isNotEmpty()) expressions += terms.take(6).joinToString(" OR ") { "\"${normalizeToken(it)}\"*" }
+
+        for (expr in expressions.distinct().filter { it.isNotBlank() }) {
+            runCatching {
+                db.rawQuery(
+                    """
+                    SELECT c.document_filename,c.pdf_page,c.content
+                    FROM chunks_fts f JOIN chunks c ON c.chunk_id=f.chunk_id
+                    WHERE chunks_fts MATCH ? AND UPPER(COALESCE(c.manual,''))='TSM'
+                    ORDER BY c.pdf_page LIMIT 260
+                    """.trimIndent(), arrayOf(expr)
+                ).use { c ->
+                    while (c.moveToNext()) {
+                        parseTsmIndexRecords(c.getString(0), c.getInt(1), c.getString(2)).forEach { r ->
+                            if (!r.hasFaultMessage) return@forEach
+                            val key = "${r.indexTaskRef}|${r.maintenanceAta}|${r.maintenanceMessage}|${r.source}|${r.faultClass}"
+                            if (seen.add(key)) records += r
+                        }
+                    }
+                }
+            }
+        }
+
+        val exact = records.filter { r ->
+            exactIndexMatch(r, input) && pfrPhotoMatchIsStrong(r, input)
+        }
+        if (exact.isNotEmpty()) return exact.sortedByDescending { indexScore(it, input) }
+
+        // Allow only DB-aware OCR-near matching for the same ATA/source/class;
+        // still fail closed if this maps to more than one Ref TASK.
+        return records.filter { r ->
+            acceptableIndexMatch(r, input) && pfrPhotoMatchIsStrong(r, input)
+        }.sortedByDescending { indexScore(it, input) }
+    }
