+    private fun cacheGalleryImage(uri: Uri): Uri {
+        val mime = contentResolver.getType(uri).orEmpty().lowercase()
+        val ext = when {
+            "png" in mime -> "png"
+            "webp" in mime -> "webp"
+            "heic" in mime || "heif" in mime -> "heic"
+            else -> "jpg"
+        }
+        val dir = File(cacheDir, "gallery").apply { mkdirs() }
+        val outFile = File(dir, "line_assistant_${photoMode.name.lowercase()}_${System.currentTimeMillis()}.$ext")
+        val input = contentResolver.openInputStream(uri) ?: error("Selected image stream is unavailable")
+        input.use { source ->
+            outFile.outputStream().use { target -> source.copyTo(target) }
+        }
+        require(outFile.length() > 0L) { "Selected image is empty" }
+        appLog.i("IMAGE_IMPORT_OK", "${outFile.length()} bytes • ${outFile.name}")
+        return FileProvider.getUriForFile(this, "$packageName.fileprovider", outFile)
+    }
